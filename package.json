{
  "name": "focus-reader",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "description": "A Chrome extension that turns a bookmark folder into a locked, finite reading queue.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:manifest": "node scripts/check-manifest.mjs",
    "build:pages": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "build": "npm run typecheck && npm run build:pages && npm run build:content && npm run check:manifest",
    "dev": "node scripts/dev.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "e2e": "node scripts/e2e-test.mjs",
    "e2e:focus": "node scripts/e2e-focus.mjs",
    "try": "node scripts/try-it.mjs",
    "install:local": "npm run build && node scripts/install-local.mjs",
    "update": "node scripts/update.mjs",
    "test": "npm run smoke && npm run e2e && npm run e2e:focus",
    "zip": "node scripts/zip.mjs",
    "release": "npm run build && node scripts/zip.mjs && node scripts/release.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
